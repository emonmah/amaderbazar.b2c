# ==============================================================================
# AMADER BAZAR (আমাদের বাজার) - B2C STOREFRONT ENVIRONMENT VARIABLES
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND API URL (CRITICAL / REQUIRED)
# ------------------------------------------------------------------------------
# The full public URL pointing to your backend REST API, ending with '/api/v1'.
# Local development: http://localhost:4000/api/v1
# Production (Render / Railway / VPS): https://your-backend.onrender.com/api/v1
NEXT_PUBLIC_API_URL=https://your-backend.onrender.com/api/v1

# ------------------------------------------------------------------------------
# 2. STORE & TENANT CONFIGURATION (Recommended)
# ------------------------------------------------------------------------------
# Sets the store to standalone dedicated mode for Amader Bazar
TENANT_MODE=STANDALONE
DEFAULT_TENANT_ID=tenant-fashion-001

# ------------------------------------------------------------------------------
# 3. RUNTIME SETTINGS
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# ------------------------------------------------------------------------------
# 4. NEXT.JS ISR REVALIDATION SECRET (Optional)
# ------------------------------------------------------------------------------
# Used by /api/revalidate when the backend notifies the storefront of catalog updates
REVALIDATION_SECRET=isr_revalidate_secret
